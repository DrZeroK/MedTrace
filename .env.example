# ---- Designated model (OpenAI-compatible chat-completions endpoint). Never commit real values.
# Aliases also accepted: OPENAI_API_BASE / OPENAI_BASE_URL / API_BASE, OPENAI_API_KEY / API_KEY, MODEL_NAME / MODEL
# The designated model is Qwen. Use the endpoint and model name the organisers provide; an OpenAI-compatible
# Qwen endpoint looks like https://dashscope.aliyuncs.com/compatible-mode/v1 with LLM_MODEL=qwen-... (confirm both).
LLM_API_BASE=mock://            # e.g. http://host:port/v1 ; mock:// = built-in offline mock
LLM_API_KEY=
LLM_MODEL=
# qwen4-max with reasoning took 50-230 s per note in testing and longer under parallel load; a 120 s limit made
# half the cases fall back. Keep this well above the slowest observed call, within the official time limit.
LLM_TIMEOUT=600                 # seconds per HTTP request
LLM_MAX_RETRIES=2               # HTTP retries per model call (timeouts, 429, 5xx only)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=0                # 0 = server default
LLM_JSON_MODE=0                 # 1 = send response_format=json_object (only if the endpoint supports it)
LLM_SEED=                       # integer; empty = omit. vLLM accepts a top-level "seed" (Q4); if unsupported, omit and explain in the submission docs
LLM_ENABLE_THINKING=            # true/false; empty = omit, leaving the server default (which is NOT necessarily "off"). Sent as chat_template_kwargs (Q7)
# LLM_EXTRA_BODY: JSON object merged into every request LAST (overrides the settings above),
# e.g. {"chat_template_kwargs": {"enable_thinking": false}} (empty = nothing)
LLM_EXTRA_BODY=

# ---- Pipeline
PIPELINE=A2                     # A0 baseline | A1 grounded | A2 grounded+verified (S1, default) | S2 | A3 (S3)
MAX_CALLS_PER_CASE=2            # logical model calls per case (the 2nd is used only to regenerate unparseable output)
MAX_REQUESTS_PER_CASE=0         # every HTTP attempt incl. retries counts (Q5); 0 = unlimited until the organisers publish a limit
REPAIR_CALL=0                   # 1 = A2 also spends a call repairing high-severity verifier findings (no benefit shown yet)
PROMPT_VERSION=v2               # v2 concise (default) | v1 original long-form
CASE_TIMEOUT=0                  # seconds, 0 = unlimited
TOTAL_TIMEOUT=0                 # seconds for the whole batch, 0 = unlimited
WORKERS=1
CUTOFF_MODE=redact              # redact | flag | off
ON_UNRESOLVED=flag              # flag (list under review_items) | drop (remove high-severity statements)

# ---- I/O contract (adjust to the official specification)
INPUT_PATH=input.json
OUTPUT_PATH=output.json
LOG_DIR=logs
OUTPUT_LANG=auto                # auto (follow the records) | en | zh
OUTPUT_ENVELOPE=auto            # auto (mirror input) | list | <key>
# OUTPUT_FIELDS: comma list to restrict fields, e.g. case_features,diagnostic_discussion,treatment_plan (empty = all)
OUTPUT_FIELDS=
OUTPUT_FIELD_MAP={}             # JSON rename map, e.g. {"treatment_plan":"diagnostic_and_treatment_plan"}
INLINE_CITATIONS=0              # 1 = append [source ids] to each statement in the text fields
NUMBERED=1
INCLUDE_META=0
STRICT_EXIT=0                   # 1 = exit code 2 when any case fell back
