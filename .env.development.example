# ============================================================================
# OFFICIAL PROVIDER MODE (default output protocol; the organiser injects .env with ONLY these two values)
# The organiser injects .env with ONLY these two values. ENDPOINT is the COMPLETE
# request URL (path included); the client uses it verbatim - no /v1 or
# /chat/completions is appended. No API key: the service is keyless and no
# Authorization header is sent.
#   MODEL_NAME=qwen3.8-27b          (designated model, organiser Q&A 2026-11-24)
#   ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
# ============================================================================
OUTPUT_PROTOCOL=official      # official = provider status/medical_record/error (default, same as the official entry point) | legacy = old note contract (opt-in)
MODEL_NAME=
ENDPOINT=

# ---- Legacy / development model config (OpenAI-compatible chat-completions).
# Used when ENDPOINT is empty. `mock://` = built-in offline mock (no model needed).
# Aliases: OPENAI_API_BASE / OPENAI_BASE_URL / API_BASE, OPENAI_API_KEY / API_KEY, MODEL / LLM_MODEL.
# Never commit a real key. LLM_API_KEY is sent as a Bearer token in development mode only
# (any output protocol); the official entry point is always keyless.
LLM_API_BASE=mock://            # e.g. http://host:port/v1 ; mock:// = built-in offline mock
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=600                 # seconds per HTTP request
LLM_MAX_RETRIES=2               # HTTP retries per model call (timeouts, 429, 5xx only)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=0                # 0 = server default
LLM_JSON_MODE=0                 # 1 = send response_format=json_object (only if the endpoint supports it)
LLM_SEED=42                     # fixed request seed. vLLM accepts a top-level "seed" (Q4). The official entry point always sends 42; if a 400 explicitly rejects it, the client strips it and retries once. Invalid values warn and fall back to 42
LLM_ENABLE_THINKING=            # true/false; empty = omit (development). The official entry point sends false; a 400 naming the field is stripped and retried once. Sent as chat_template_kwargs (Q7)
# LLM_EXTRA_BODY: JSON object merged into every request LAST (overrides the settings above),
# e.g. {"chat_template_kwargs": {"enable_thinking": false}} (empty = nothing)
LLM_EXTRA_BODY=

# ---- Pipeline
PIPELINE=A2                     # A0 baseline | A1 grounded | A2 grounded+verified (S1, default) | S2 | A3 (S3)
MAX_CALLS_PER_CASE=2            # logical model calls per case (the 2nd is used only to regenerate unparseable output)
MAX_REQUESTS_PER_CASE=0         # every HTTP attempt incl. retries counts (Q5); 0 = no separate cap (official time ceilings still bound the run) until the organisers publish a limit
REPAIR_CALL=0                   # 1 = A2 also spends a call repairing high-severity verifier findings (no benefit shown yet)
PROMPT_VERSION=v2               # v2 concise (default) | v1 original long-form
CONTEXT_MODE=legacy             # legacy | zh_context_v1 (development candidate only)
PROMPT_CANDIDATE_PATH=          # absolute path to a validated phase-one candidate JSON; empty = fixed v2
CASE_TIMEOUT=0                  # development: seconds, 0 = unlimited. Official entry point uses a 300 s safety ceiling.
TOTAL_TIMEOUT=0                 # development: seconds for the whole batch, 0 = unlimited. Official entry point uses a 3600 s safety ceiling.
TIME_RESERVE_SECONDS=2          # headroom (our safety margin, not an official limit); only when a time budget is set:
                                # below it, optional steps (extract/regenerate/repair/review) are skipped, logged as time_budget_skipped
WORKERS=1
CUTOFF_MODE=redact              # redact | flag | off
ON_UNRESOLVED=flag              # flag (list under review_items) | drop (remove high-severity statements)

# ---- I/O contract (adjust to the official specification)
INPUT_PATH=input.json
OUTPUT_PATH=output.json
OUTPUT_ALIASES=                 # comma list of extra filenames written beside the primary after every atomic write;
                                # OUTPUT_ALIASES=results.json covers both precheck names (Q9); final name awaits the official spec
LOG_DIR=logs
OUTPUT_LANG=auto                # auto (follow the records) | en | zh
OUTPUT_ENVELOPE=auto            # auto (mirror input) | list | <key>
# OUTPUT_FIELDS: comma list to restrict fields, e.g. case_features,diagnostic_discussion,treatment_plan (empty = all)
OUTPUT_FIELDS=
OUTPUT_FIELD_MAP={}             # JSON rename map, e.g. {"treatment_plan":"diagnostic_and_treatment_plan"}
INLINE_CITATIONS=0              # 1 = append [source ids] to each statement in the text fields
INCLUDE_META=0
STRICT_EXIT=0                   # 1 = exit code 2 when any case fell back
# Offline knowledge: absolute path to a reviewed SQLite release; empty disables it.
KB_PATH=
